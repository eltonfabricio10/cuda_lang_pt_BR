"│ Choose file                │       Ctrl+B │      Shift+Сlick  \"Browse\" │                                           │\n"
"│ Depth \"Only\"               │        Alt+Y │                  Ctrl+Num0 │                                           │\n"
"│ Depth \"+1 level\"           │        Alt+! │                  Ctrl+Num1 │                                           │\n"
"│ Depth \"All\"                │        Alt+L │                  Ctrl+Num9 │                                           │\n"
"├────────────────────────────┼──────────────┼────────────────────────────┼───────────────────────────────────────────┤\n"
