#: CudaText_addons/langmenu/cuda_sort/__init__.py:61
#, python-format
msgid ""
"Document has too many lines. Plugin Sort will not work. Current value of "
"option [sort] max_lines in \"settings/plugins.ini\" is %d."
msgstr "O documento tem muitas linhas. A classificação do plug-in não funcionará. O valor atual da opção [sort] max_lines em \"settings/plugins.ini\" é %d."

#: CudaText_addons/langmenu/cuda_sort/__init__.py:63
